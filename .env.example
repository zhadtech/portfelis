# Copy to .env and fill in. .env is gitignored and must never be committed.
# CI supplies these as GitHub repository variables (see .github/workflows/deploy.yml).
#
# Every value is optional. With none set, the site builds with neutral placeholders,
# which is the intended state of a fresh clone or a fork.

# Which content the build uses. Leave empty (the normal case) and the private submodule
# mounts are used when they have content, falling back to src/content/samples/ when they
# do not. Set to "samples" to force the placeholders even with the mounts checked out —
# the way to see what a fresh clone sees without unmounting anything.
# Not prefixed PUBLIC_: it is read at build time only and never reaches the browser.
CONTENT_SOURCE=

# Where the site is served from. Used for the RSS feed's absolute URLs.
PUBLIC_SITE_URL=https://example.github.io

# The GitHub Pages project-site subpath. Use "/" for a user or custom-domain site.
PUBLIC_BASE_PATH=/portfelis

# Identity. Shown in the header, footer, page titles and the feed.
PUBLIC_SITE_NAME=Portfolio
PUBLIC_SITE_TAGLINE=Selected work and writing
PUBLIC_AUTHOR_HANDLE=@handle

# Web3Forms access key. Public by design — it identifies the form, not the account.
# Leave empty and the contact page shows social links instead of a form.
PUBLIC_CONTACT_FORM_KEY=

# Social links. Each renders only when non-empty.
PUBLIC_SOCIAL_GITHUB=
PUBLIC_SOCIAL_LINKEDIN=
PUBLIC_SOCIAL_X=
