# Private content mounts. The build falls back to src/content/samples/ when these
# directories are empty, which is the state of a fresh clone before
# `npm run content:on` (or `git submodule update --init`).
#
# URLs must be HTTPS, not SSH: CI applies secrets.CONTENT_PAT to HTTPS only.
[submodule "src/content/blog"]
	path = src/content/blog
	url = https://github.com/zhadtech/portfelis-blog.git
	branch = main
[submodule "src/content/projects"]
	path = src/content/projects
	url = https://github.com/zhadtech/portfelis-projects.git
	branch = main
