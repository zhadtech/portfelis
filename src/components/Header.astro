---
import { nav, site } from '../config/site';
import { href, isActive } from '../lib/paths';

const { pathname } = Astro.url;
---

<header class="border-b border-line">
  <div
    class="mx-auto flex w-full max-w-shell items-baseline justify-between gap-6 px-6 py-6 sm:px-8"
  >
    <a
      href={href('/')}
      class="text-base font-semibold tracking-tight text-ink transition-colors duration-150 hover:text-accent-strong"
    >
      {site.name}
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-baseline gap-5 text-sm sm:gap-7">
        {
          nav.map((item) => {
            const active = isActive(pathname, item.path);
            return (
              <li>
                <a
                  href={href(item.path)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'underline-offset-[7px] transition-colors duration-150',
                    active
                      ? 'text-ink underline decoration-accent decoration-1'
                      : 'text-muted hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
