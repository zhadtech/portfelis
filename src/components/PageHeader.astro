---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  /** The page's `h1`. */
  title: string;
  icon?: IconName;
  /** One plain sentence under the title. */
  lead?: string;
  /** A way back up, shown above the title. `href` is already passed through `href()`. */
  back?: { href: string; label: string };
  class?: string;
}

const { title, icon, lead, back, class: className } = Astro.props;
---

<header class:list={['border-b-2 border-tint-soft pb-6', className]}>
  {
    back && (
      <a
        href={back.href}
        class="mb-3 inline-flex items-center gap-1.5 text-sm text-accent-strong transition-colors duration-150 hover:text-accent-deep hover:underline hover:underline-offset-4"
      >
        <Icon name="arrow-left" />
        {back.label}
      </a>
    )
  }
  <h1 class="flex items-center gap-3 text-3xl text-accent-strong">
    {icon && <Icon name={icon} class="size-[0.8em] [stroke-width:1.75] text-accent" />}
    {title}
  </h1>
  {lead && <p class="mt-3 max-w-measure text-body">{lead}</p>}
  <slot />
</header>
