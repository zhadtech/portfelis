---
import FormattedDate from './FormattedDate.astro';
import Icon from './Icon.astro';
import PillLink from './PillLink.astro';
import TagList from './TagList.astro';
import { href } from '../lib/paths';
import { postPath, readingMinutes, type Post } from '../lib/content';

interface Props {
  post: Post;
  /** Render the heading as h2 (in a list page) or h3 (under a section heading). */
  headingLevel?: 'h2' | 'h3';
  showTags?: boolean;
}

const { post, headingLevel = 'h2', showTags = false } = Astro.props;
const { title, description, date, tags } = post.data;
const Heading = headingLevel;
const url = href(postPath(post));
---

<article>
  <Heading class="border-b-2 border-dotted border-tint pb-2 text-xl text-accent-strong">
    <a href={url} class="transition-colors duration-150 hover:text-accent-deep">{title}</a>
  </Heading>

  <p
    class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold tracking-wider text-muted uppercase"
  >
    <span class="inline-flex items-center gap-1.5">
      <Icon name="calendar" class="size-[1.25em] text-accent" />
      <FormattedDate date={date} format="short" />
    </span>
    <span class="inline-flex items-center gap-1.5">
      <Icon name="clock" class="size-[1.25em] text-accent" />
      {readingMinutes(post)} min read
    </span>
  </p>

  <p class="mt-4">{description}</p>

  {showTags && tags.length > 0 && <TagList tags={tags} class="mt-4" />}

  <PillLink href={url} iconEnd="chevrons-right" class="mt-5">
    Read<span class="sr-only">: {title}</span>
  </PillLink>
</article>
