---
import { href } from '../lib/paths';
import { tagSlug, type Tag } from '../lib/content';

interface Props {
  /** Raw frontmatter labels, or resolved tags when counts are wanted. */
  tags: readonly (string | Tag)[];
  /** Slug of the tag page being viewed, if any — that chip is marked current. */
  activeSlug?: string;
  showCounts?: boolean;
  class?: string;
}

const { tags, activeSlug, showCounts = false, class: className } = Astro.props;

const items = tags.map((tag) =>
  typeof tag === 'string' ? { tag, slug: tagSlug(tag), count: 0 } : tag,
);
---

<ul class:list={['flex flex-wrap gap-1.5', className]}>
  {
    items.map(({ tag, slug, count }) => {
      const counted = showCounts && count > 0;
      return (
        <li>
          <a
            href={href(`/blog/tags/${slug}`)}
            aria-current={slug === activeSlug ? 'page' : undefined}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-chip border py-0.5 pl-2 text-sm transition-colors duration-150',
              counted ? 'pr-1' : 'pr-2',
              slug === activeSlug
                ? 'border-accent bg-accent-wash text-accent-strong'
                : 'border-line bg-surface text-body hover:border-accent hover:text-accent-strong',
            ]}
          >
            {tag}
            {counted && (
              <span class="tabular rounded-[3px] bg-tint-soft px-1.5 text-xs font-semibold text-accent-deep">
                <span class="sr-only">(</span>
                {count}
                <span class="sr-only"> posts)</span>
              </span>
            )}
          </a>
        </li>
      );
    })
  }
</ul>
