---
import { href } from '../lib/paths';
import { tagSlug, type Tag } from '../lib/content';

interface Props {
  /** Raw frontmatter labels, or resolved tags when counts are wanted. */
  tags: readonly (string | Tag)[];
  /** Slug of the tag page being viewed, if any — that chip is marked current. */
  activeSlug?: string;
  showCounts?: boolean;
  class?: string;
}

const { tags, activeSlug, showCounts = false, class: className } = Astro.props;

const items = tags.map((tag) =>
  typeof tag === 'string' ? { tag, slug: tagSlug(tag), count: 0 } : tag,
);
---

<ul class:list={['flex flex-wrap gap-2', className]}>
  {
    items.map(({ tag, slug, count }) => (
      <li>
        <a
          href={href(`/blog/tags/${slug}`)}
          aria-current={slug === activeSlug ? 'page' : undefined}
          class:list={[
            'inline-flex items-baseline gap-1.5 rounded-sm border px-2 py-0.5 text-sm transition-colors duration-150',
            slug === activeSlug
              ? 'border-accent text-accent-strong'
              : 'border-line text-muted hover:border-accent hover:text-accent-strong',
          ]}
        >
          {tag}
          {showCounts && count > 0 && <span class="tabular text-xs opacity-70">{count}</span>}
        </a>
      </li>
    ))
  }
</ul>
