---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PillLink from '../components/PillLink.astro';
import { href } from '../lib/paths';
import { nav } from '../config/site';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <div class="mx-auto w-full max-w-shell px-4 py-16 sm:px-8 sm:py-24">
    <div class="max-w-measure">
      <p class="tabular mb-2 font-display text-sm font-bold tracking-widest text-accent uppercase">
        404
      </p>
      <PageHeader
        title="That page does not exist"
        lead="The link may be out of date, or the page may have moved."
      />

      {/* `nav` starts with Home, so every way back is here exactly once. */}
      <ul class="mt-8 flex flex-wrap gap-2.5">
        {
          nav.map((item, index) => (
            <li>
              <PillLink
                href={href(item.path)}
                icon={item.icon}
                variant={index === 0 ? 'solid' : 'quiet'}
              >
                {item.label}
              </PillLink>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
