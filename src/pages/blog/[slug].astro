---
import type { GetStaticPaths } from 'astro';
import PostLayout from '../../layouts/PostLayout.astro';
import { getNews } from '../../lib/content';

// See the note in src/pages/projects/[slug].astro about flat content files.
// Research posts are not here: they live under /writing, which is where postPath() sends them.
export const getStaticPaths = (async () => {
  const posts = await getNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<PostLayout post={post} back={{ path: '/blog', label: 'All posts' }} />
