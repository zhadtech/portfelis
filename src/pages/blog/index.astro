---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostRow from '../../components/PostRow.astro';
import TagList from '../../components/TagList.astro';
import { href } from '../../lib/paths';
import { getAllTags, getNews, groupByYear } from '../../lib/content';

const years = groupByYear(await getNews());
const tags = await getAllTags();
---

<BaseLayout title="Blog" description="AI news, collected and published automatically.">
  <div class="mx-auto w-full max-w-shell px-4 py-12 sm:px-8 sm:py-16">
    <PageHeader
      title="Blog"
      icon="newspaper"
      lead="AI news, collected and published automatically."
    >
      <p class="mt-1 text-sm text-muted">
        Longer pieces I research and edit by hand are under{' '}
        <a
          href={href('/writing')}
          class="text-accent-strong underline decoration-tint underline-offset-4 transition-colors duration-150 hover:decoration-current"
          >Writing</a
        >.
      </p>
    </PageHeader>

    <div class="sidebar-layout mt-10">
      <div class="main space-y-12">
        {
          years.length > 0 ? (
            years.map(({ year, posts }) => (
              <section aria-labelledby={`year-${year}`}>
                <h2
                  id={`year-${year}`}
                  class="flex items-baseline justify-between gap-4 border-b-2 border-tint-soft pb-2 text-2xl text-accent-strong"
                >
                  <span class="tabular">{year}</span>
                  <span class="tabular font-sans text-sm font-normal text-muted">
                    {posts.length} {posts.length === 1 ? 'post' : 'posts'}
                  </span>
                </h2>
                <ul class="mt-5">
                  {posts.map((post) => (
                    <PostRow post={post} dateFormat="day" />
                  ))}
                </ul>
              </section>
            ))
          ) : (
            <p class="text-muted">No posts published yet.</p>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <aside class="lead" aria-label="Topics">
            <Card title="Topics" icon="tag">
              <TagList tags={tags} showCounts />
            </Card>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
