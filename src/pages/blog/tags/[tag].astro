---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostRow from '../../../components/PostRow.astro';
import TagList from '../../../components/TagList.astro';
import { href } from '../../../lib/paths';
import { getAllTags, getPostsByTag } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const tags = await getAllTags();
  return Promise.all(
    tags.map(async (tag) => ({
      params: { tag: tag.slug },
      props: { tag, posts: await getPostsByTag(tag.slug) },
    })),
  );
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
const allTags = await getAllTags();
const count = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`;
---

<BaseLayout title={`Tagged ${tag.tag}`} description={`Posts tagged ${tag.tag}. ${count}.`}>
  <div class="mx-auto w-full max-w-shell px-4 py-12 sm:px-8 sm:py-16">
    <PageHeader title={tag.tag} icon="tag" back={{ href: href('/blog'), label: 'Blog' }}>
      <p class="tabular mt-2 text-sm text-muted">{count}</p>
    </PageHeader>

    <div class="sidebar-layout mt-10">
      {/* Tags span both sections, so each row says when a post is from Writing. */}
      <ul class="main">
        {posts.map((post) => <PostRow post={post} showKind />)}
      </ul>

      <aside class="lead" aria-label="Topics">
        <Card title="Topics" icon="tag">
          <TagList tags={allTags} activeSlug={tag.slug} showCounts />
        </Card>
      </aside>
    </div>
  </div>
</BaseLayout>
