---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, socials } from '../config/site';

const hasForm = site.contactFormKey !== '';

// Say only what is true of this build, and nothing about how it was built: "the form is
// not configured" is a note to the owner, not to a visitor.
const lead = hasForm
  ? 'Hiring, or want to talk about something on this site? Send a message and I will get back to you.'
  : socials.length > 0
    ? 'Hiring, or want to talk about something on this site? The links here are the best way to reach me.'
    : 'No contact channels are set up yet.';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <div class="mx-auto w-full max-w-shell px-4 py-12 sm:px-8 sm:py-16">
    <PageHeader title="Contact" icon="mail" lead={lead} />

    <div class="sidebar-layout mt-10">
      <div class="main">
        <ContactForm />

        {
          import.meta.env.DEV && !hasForm && (
            <p class="max-w-measure text-sm text-muted">
              Set <code class="font-mono">PUBLIC_CONTACT_FORM_KEY</code> in{' '}
              <code class="font-mono">.env</code> to render the form. See{' '}
              <code class="font-mono">.env.example</code>.
            </p>
          )
        }
      </div>

      {
        socials.length > 0 && (
          <aside class="lead" aria-label="Elsewhere">
            <Card title="Elsewhere" icon="link">
              <ul class="space-y-2">
                {socials.map((social) => (
                  <li>
                    <a
                      href={social.url}
                      rel="me noopener"
                      class="flex items-center gap-2.5 transition-colors duration-150 hover:text-accent-strong [&>svg]:text-muted"
                    >
                      <Icon name={social.icon} class="size-[1.15em]" />
                      {social.label}
                    </a>
                  </li>
                ))}
              </ul>
            </Card>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
