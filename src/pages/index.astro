---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import PostRow from '../components/PostRow.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, socials } from '../config/site';
import { href } from '../lib/paths';
import { getNews, getProjectsByPriority, getResearch } from '../lib/content';

// Strongest material first: projects, then curated long-form, then the automated feed.
const projects = (await getProjectsByPriority()).slice(0, 3);
const research = (await getResearch()).slice(0, 3);
const news = (await getNews()).slice(0, 4);
const isEmpty = projects.length + research.length + news.length === 0;

const LINK =
  'flex items-center gap-2.5 transition-colors duration-150 hover:text-accent-strong [&>svg]:text-muted';
---

<BaseLayout title={site.name} description={site.tagline}>
  <div class="sidebar-layout mx-auto w-full max-w-shell px-4 pt-6 sm:px-8 split:pt-12">
    <ProfileCard class="lead" />

    <div class="main space-y-16">
      {
        projects.length > 0 && (
          <section aria-labelledby="home-work">
            <SectionHeading
              id="home-work"
              title="Featured work"
              icon="briefcase"
              more={{ href: href('/projects'), label: 'All projects' }}
            />
            <div class="space-y-10">
              {projects.map((project) => (
                <ProjectCard project={project} headingLevel="h3" />
              ))}
            </div>
          </section>
        )
      }

      {
        research.length > 0 && (
          <section aria-labelledby="home-writing">
            <SectionHeading
              id="home-writing"
              title="Writing"
              icon="notebook-pen"
              more={{ href: href('/writing'), label: 'All writing' }}
            />
            <div class="space-y-12">
              {research.map((post) => (
                <PostCard post={post} headingLevel="h3" />
              ))}
            </div>
          </section>
        )
      }

      {
        news.length > 0 && (
          <section aria-labelledby="home-blog">
            <SectionHeading
              id="home-blog"
              title="From the blog"
              icon="newspaper"
              more={{ href: href('/blog'), label: 'All posts' }}
            />
            <ul>
              {news.map((post) => (
                <PostRow post={post} />
              ))}
            </ul>
          </section>
        )
      }

      {isEmpty && <p class="text-muted">Nothing published yet.</p>}
    </div>

    <aside class="side" aria-label="Elsewhere">
      <Card title="Links" icon="link">
        <ul class="space-y-2">
          {
            socials.map((social) => (
              <li>
                <a href={social.url} rel="me noopener" class={LINK}>
                  <Icon name={social.icon} class="size-[1.15em]" />
                  {social.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={href('/rss.xml')} class={LINK}>
              <Icon name="rss" class="size-[1.15em]" />
              RSS feed
            </a>
          </li>
        </ul>
      </Card>
    </aside>
  </div>
</BaseLayout>
