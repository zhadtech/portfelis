---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ProseLayout from '../../layouts/ProseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Icon from '../../components/Icon.astro';
import PillLink from '../../components/PillLink.astro';
import { href } from '../../lib/paths';
import { getProjects } from '../../lib/content';

// Entry ids come from the file name, so content files must stay flat — a nested
// folder would put a slash in the slug. See src/pages/_AGENTS.md.
export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, description, date, tech, repo, demo, featured, cover, draft } = project.data;
const { Content } = await render(project);
const initial = title.trim().charAt(0).toUpperCase();
---

<ProseLayout title={title} description={description}>
  <Fragment slot="header">
    {
      draft && (
        <p class="mb-4 text-sm font-semibold text-accent-strong">
          Draft — not included in a production build.
        </p>
      )
    }

    <div
      aria-hidden="true"
      class="mx-auto mb-5 grid size-16 place-items-center rounded-card bg-accent font-display text-3xl font-extrabold text-on-accent shadow-card"
    >
      {initial}
    </div>

    <h1 class="text-3xl text-accent-strong">
      {title}
      {
        featured && (
          <Icon
            name="star"
            label="Featured"
            class="ml-1 inline size-[0.7em] align-[-0.02em] text-accent"
          />
        )
      }
    </h1>
    <p class="mt-4 text-body">{description}</p>

    <div class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1.5 text-sm">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" class="text-accent" />
        <FormattedDate date={date} format="short" />
      </span>
      {
        tech.length > 0 && (
          <>
            <span class="text-tint" aria-hidden="true">
              /
            </span>
            <span class="sr-only">Built with</span>
            <ul class="flex flex-wrap justify-center gap-1.5">
              {tech.map((item) => (
                <li class="rounded-[4px] bg-accent px-1.5 py-1 text-xs leading-none font-semibold text-on-accent">
                  {item}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    {
      (repo || demo) && (
        <div class="mt-6 flex flex-wrap justify-center gap-2.5">
          {repo && (
            <PillLink href={repo} external icon="code">
              Repository
            </PillLink>
          )}
          {demo && (
            <PillLink href={demo} external variant="quiet" icon="external-link">
              Live demo
            </PillLink>
          )}
        </div>
      )
    }
  </Fragment>

  {cover && <Image src={cover} alt="" widths={[640, 1024]} sizes="(min-width: 68ch) 68ch, 100vw" />}
  <Content />

  <Fragment slot="footer">
    <PillLink href={href('/projects')} variant="quiet" icon="arrow-left">All projects</PillLink>
  </Fragment>
</ProseLayout>
