---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectsByPriority } from '../../lib/content';

const projects = await getProjectsByPriority();
---

<BaseLayout
  title="Work"
  description="Selected projects, most substantial first, with the constraint each one was built against."
>
  <div class="mx-auto w-full max-w-shell px-6 py-16 sm:px-8 sm:py-24">
    <header class="max-w-measure border-b border-line pb-8">
      <h1 class="text-3xl text-ink">Work</h1>
      <p class="mt-4 text-body">
        Selected projects. Each entry names the constraint it was built against, which is usually
        the only part worth reading.
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div class="mt-12 grid gap-10 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="mt-12 text-muted">No projects published yet.</p>
      )
    }
  </div>
</BaseLayout>
