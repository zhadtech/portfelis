---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectsByPriority } from '../../lib/content';

const projects = await getProjectsByPriority();
---

<BaseLayout
  title="Work"
  description="Projects I have built, featured first, with what each one does and what it was built with."
>
  <div class="mx-auto w-full max-w-shell px-4 py-12 sm:px-8 sm:py-16">
    <div class="max-w-measure">
      <PageHeader
        title="Work"
        icon="briefcase"
        lead="Projects I have built, featured ones first. Each says what it does and what it was built with."
      />

      {
        projects.length > 0 ? (
          <div class="mt-10 space-y-12">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        ) : (
          <p class="mt-10 text-muted">No projects published yet.</p>
        )
      }
    </div>
  </div>
</BaseLayout>
