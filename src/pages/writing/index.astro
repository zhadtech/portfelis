---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { href } from '../../lib/paths';
import { getResearch } from '../../lib/content';

const posts = await getResearch();
---

<BaseLayout title="Writing" description="Long-form research, written and edited by hand.">
  <div class="mx-auto w-full max-w-shell px-4 py-12 sm:px-8 sm:py-16">
    <div class="max-w-measure">
      <PageHeader
        title="Writing"
        icon="notebook-pen"
        lead="Long-form research, written and edited by hand."
      />

      {
        posts.length > 0 ? (
          <div class="mt-10 space-y-12">
            {posts.map((post) => (
              <PostCard post={post} showTags />
            ))}
          </div>
        ) : (
          <p class="mt-10 text-muted">
            No long-form pieces published yet. Shorter posts are on the{' '}
            <a
              href={href('/blog')}
              class="text-accent-strong underline decoration-tint underline-offset-4 transition-colors duration-150 hover:decoration-current"
            >
              blog
            </a>
            .
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>
